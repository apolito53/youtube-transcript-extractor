# Optional: extraction and deterministic cleanup work without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local server settings.
YTX_HOST=127.0.0.1
YTX_PORT=8765
YTX_MAX_TRANSCRIPT_CHARS=500000
# Optional override; defaults to ~/.cache/youtube-transcript-extractor/transcripts.sqlite3
YTX_CACHE_PATH=

# Optional outbound proxy for hosted deployments. Leave blank for direct local requests.
# Recommended: a Webshare Rotating Residential endpoint (not its datacenter plan).
# Example: http://username:password@p.webshare.io:80
YTX_PROXY_URL=

# Gate B / Phase 0 synthetic x402 probe. Disabled by default and never calls
# YouTube or OpenAI. Base Sepolia exact payment uses test USDC only.
YTX_PHASE0_X402_ENABLED=false
YTX_PHASE0_FACILITATOR_URL=https://x402.org/facilitator
YTX_PHASE0_NETWORK=eip155:84532
YTX_PHASE0_PRICE=$0.001
YTX_PHASE0_PAY_TO_ADDRESS=
YTX_PHASE0_EXPECTED_BUYER_ADDRESS=
# Optional override; Fly uses /data/phase0.sqlite3.
YTX_PHASE0_STATE_PATH=
